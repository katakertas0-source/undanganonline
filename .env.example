# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Portal Credentials
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# Lynk.id Payment Gateway Integration
# Required on server-side only for webhook signature calculation and verification
LYNK_MERCHANT_KEY=your-lynk-merchant-key-here
LYNK_WEBHOOK_SECRET=your-lynk-webhook-secret-here
# Optional Lynk checkout configuration
LYNK_PRODUCT_ID=
LYNK_BASE_URL=https://lynk.id
